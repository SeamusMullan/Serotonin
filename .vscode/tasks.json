{
    "tasks": [
        {
            "type": "shell",
            "label": "Build All (Serotonin)",
            "command": "./build.sh",
            "options": {
                "cwd": "${workspaceFolder}/build",
                "env": {
                    "PATH": "${workspaceFolder}/build-tools/bin/bin:${env:PATH}"
                }
            },
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": ["relative", "${workspaceFolder}/kernel"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build entire Serotonin OS kernel and create ISO"
        },
        {
            "type": "shell",
            "label": "Build All (Debug)",
            "command": "./build.sh",
            "args": ["-g"],
            "options": {
                "cwd": "${workspaceFolder}/build",
                "env": {
                    "PATH": "${workspaceFolder}/build-tools/bin/bin:${env:PATH}"
                }
            },
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": ["relative", "${workspaceFolder}/kernel"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "group": "build",
            "detail": "Build Serotonin OS kernel with debug symbols"
        }
    ],
    "version": "2.0.0"
}